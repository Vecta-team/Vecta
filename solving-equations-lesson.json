{"format":"vecta/0.1","id":"solving-equations","title":"Solving a linear equation","subject":"Maths","level":"Ages 12-14","language":"en","voice":"placeholder","duration":30.22,"board":{"aspect":"16:9"},"audio":[{"src":"voice.opus","type":"audio/ogg; codecs=opus"},{"src":"voice.m4a","type":"audio/mp4"}],"captions":[{"t":0.0,"text":"Let's solve an equation. Two x plus three equals eleven."},{"t":4.94,"text":"Our goal is to get x on its own."},{"t":8.06,"text":"First, take away three from both sides."},{"t":11.79,"text":"That leaves two x equals eight."},{"t":14.74,"text":"Now divide both sides by two."},{"t":17.84,"text":"So x equals four."},{"t":20.28,"text":"Let's check our answer. Put four back into the equation."},{"t":25.01,"text":"Two times four is eight. Plus three is eleven. It works."}],"elements":[{"t":0.2,"type":"text","value":"Solving an equation","x":50,"y":11,"size":7,"weight":700},{"t":1.6,"type":"math","value":"2x + 3 = 11","x":40,"y":30,"size":7},{"t":5.34,"type":"text","value":"goal: x on its own","x":80,"y":30,"size":4.5,"color":"muted"},{"t":8.56,"type":"math","value":"2x + 3 - 3 = 11 - 3","x":40,"y":45,"size":5.5,"color":"muted"},{"t":12.39,"type":"math","value":"2x = 8","x":40,"y":58,"size":7},{"t":15.24,"type":"math","value":"\\frac{2x}{2} = \\frac{8}{2}","x":40,"y":73,"size":5.5,"color":"muted"},{"t":18.24,"type":"math","value":"x = 4","x":40,"y":89,"size":6.5,"color":"accent","box":true},{"t":20.28,"type":"clear"},{"t":20.48,"type":"text","value":"Check","x":50,"y":14,"size":8,"weight":700},{"t":22.28,"type":"math","value":"2 \\times 4 + 3","x":50,"y":38,"size":7},{"t":25.41,"type":"math","value":"= 8 + 3","x":50,"y":54,"size":7},{"t":27.21,"type":"math","value":"= 11","x":50,"y":70,"size":7,"color":"accent","box":true},{"t":28.61,"type":"text","value":"✓ x = 4 is correct","x":50,"y":87,"size":5,"color":"accent"}]}