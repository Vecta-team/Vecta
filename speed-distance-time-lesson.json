{"format":"vecta/0.1","id":"speed-distance-time","title":"Speed, distance and time","subject":"Physics","level":"Ages 11-14","language":"en","voice":"placeholder","duration":25.43,"board":{"aspect":"16:9"},"audio":[{"src":"voice.opus","type":"audio/ogg; codecs=opus"},{"src":"voice.m4a","type":"audio/mp4"}],"captions":[{"t":0.0,"text":"Speed tells us how fast something moves."},{"t":3.53,"text":"A car travels one hundred and twenty kilometres in two hours."},{"t":8.52,"text":"To find speed, we divide the distance by the time."},{"t":12.88,"text":"So the speed is one hundred and twenty, divided by two."},{"t":17.81,"text":"That is sixty kilometres per hour."},{"t":20.88,"text":"Remember. Speed equals distance divided by time."}],"elements":[{"t":0.2,"type":"text","value":"Speed, distance and time","x":50,"y":11,"size":7,"weight":700},{"t":3.93,"type":"dot","x":12,"y":55},{"t":4.13,"type":"arrow","x1":12,"y1":55,"x2":88,"y2":55,"dur":1.6},{"t":6.13,"type":"text","value":"120 km","x":50,"y":48,"size":5},{"t":7.53,"type":"text","value":"2 hours","x":50,"y":63,"size":5,"color":"muted"},{"t":9.12,"type":"math","value":"\\text{speed} = \\dfrac{\\text{distance}}{\\text{time}}","x":50,"y":29,"size":5.5},{"t":13.48,"type":"math","value":"\\text{speed} = \\dfrac{120\\ \\text{km}}{2\\ \\text{h}}","x":33,"y":83,"size":5.5},{"t":18.31,"type":"math","value":"= 60\\ \\text{km/h}","x":70,"y":83,"size":6,"color":"accent","box":true},{"t":21.18,"type":"highlight","x":50,"y":29,"w":46,"h":17}]}